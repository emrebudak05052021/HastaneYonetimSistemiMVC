@using mvcHastane.Models
@model mvcHastane.Models.tbl_Doktorlar
@{
    ViewBag.Title = "DoktorGetir";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

@using (Html.BeginForm("Guncelle", "Doktor", FormMethod.Post))
{
    <table class="table table-bordered table-dark" style="background-color:#1c1c1c; color:white; border-radius:15px;">
        <tr>
            <td>@Html.LabelFor(x => x.doktorID)</td>
            <td>@Html.TextBoxFor(x => x.doktorID, new { @class = "form-control" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(x => x.doktorAd)</td>
            <td>@Html.TextBoxFor(x => x.doktorAd, new { @class = "form-control" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(x => x.doktorSoyad)</td>
            <td>@Html.TextBoxFor(x => x.doktorSoyad, new { @class = "form-control" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(x => x.doktorUzmanlik)</td>
            <td>@Html.TextBoxFor(x => x.doktorUzmanlik, new { @class = "form-control" })</td>
        </tr>
        <tr>
            <td>@Html.LabelFor(x => x.durum)</td>
            <td>@Html.TextBoxFor(x => x.durum, new { @class = "form-control" })</td>
        </tr>
        
    </table>
    <button class="btn btn-warning">DOKTORU GÜNCELLE</button>
}
