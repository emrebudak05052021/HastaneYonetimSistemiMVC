@using mvcHastane.Models
@model mvcHastane.Models.tbl_Tedavi
@{
    ViewBag.Title = "TedaviEkle";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<form method="post" class="form-group">
    <table class="table table-bordered table-dark" style="background-color:#1c1c1c; color:white; border-radius:15px;">
        <tr>
            <td>ŞU HASTA:</td>
        </tr>
        <tr>
            <td>@Html.DropDownListFor(x => x.hastaID, (List<SelectListItem>)ViewBag.dgrhst, new { @class = "form-control" })
        </tr>

        <tr>
            <td>ŞU DOKTORA:</td>
        </tr>
        <tr>
            <td>@Html.DropDownListFor(x => x.doktorID, (List<SelectListItem>)ViewBag.dgrdkt, new { @class = "form-control" })</td>
        </tr>

        <tr>
            <td>UYGULANAN TEDAVİ:</td>
        </tr>
        <tr>
            <td>@Html.TextBoxFor(x => x.tedaviIcerik, new { @class = "form-control" })</td>
        </tr>

        <tr>
            <td>ŞU TARİHTE:</td>
        </tr>
        <tr>
            <td>@Html.TextBoxFor(x => x.tarih, new { @class = "form-control", Type = "date" })</td>
        </tr>

        <tr>
            <td>REÇETE KODU:</td>
        </tr>
        <tr>
            <td>@Html.TextBoxFor(x => x.recete, new { @class = "form-control" })</td>
        </tr>
        <tr>
            <td>TOPLAM TEDAVİ ÜCRETİ:</td>
        </tr>
        <tr>
            <td>@Html.TextBoxFor(x => x.fiyat, new { @class = "form-control"})</td>
        </tr>
    </table>
    <button class="btn btn-warning" type="submit">YENİ TEDAVİ OLUŞTUR</button>
</form>

